#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail
set -o xtrace

if [ -z "${VERSION:-}" ]; then
  echo "No version specified"
  exit 1
else
  echo "Creating release branch for ${VERSION}"
fi

# Resolve the upstream remote instead of assuming 'origin', which may be a fork.
REMOTE="$(uv run scripts/release_helper/git_remotes.py)"

git switch -c "$VERSION"

uv run scripts/release_helper/prepare_release_branch.py "$VERSION"
rm doc/publish.yml

git add doc/antora.yml doc/package.json doc/preview.yml doc/publish.yml .github/workflows
git commit -m "Prepare release branch"

git show --stat --oneline HEAD

read -r -p "Push release branch '${VERSION}' to '${REMOTE}'? [y/N] " reply || reply=""
case "$reply" in
  [yY] | [yY][eE][sS])
    git push --set-upstream "$REMOTE" "$VERSION"
    ;;
  *)
    echo "Not pushing. The release branch remains local." >&2
    echo "Inspect it with 'git show', then push manually with:" >&2
    echo "    git push --set-upstream ${REMOTE} ${VERSION}" >&2
    echo "Or discard it with 'git checkout - && git branch -D ${VERSION}'." >&2
    exit 1
    ;;
esac

echo "Published branch"

git checkout -
